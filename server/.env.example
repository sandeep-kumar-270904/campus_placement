# ==============================================================================
# PLACEearly - Multi-Tenant Placement Operating System Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the appropriate values for your environment.
# In production, ensure all secrets are cryptographically strong (>= 32 chars).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
# Server listening port
# Type: number | Default: 5001
PORT=5001

# Environment mode: 'development' | 'production' | 'test'
# Type: string | Default: development
NODE_ENV=development

# Allowed Frontend URL for CORS, Cookie domain, and deep-link generation
# Type: string (URL) | Default: http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection string (supports standalone, replica sets, Atlas)
# In production, use MongoDB Atlas with SSL and connection pooling.
# Type: string (URI) | Default: mongodb://127.0.0.1:27017/placeearly
MONGO_URI=mongodb://127.0.0.1:27017/placeearly

# Threshold in milliseconds to flag and log slow queries in structured JSON
# Type: number | Default: 100
SLOW_QUERY_THRESHOLD_MS=100

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Primary secret for signing 15-minute access tokens
# CRITICAL: In production, generate using `openssl rand -base64 48`
# Type: string (min 32 chars)
JWT_SECRET=placeearly_super_secure_random_jwt_secret_min_32_bytes_long!

# Dedicated secret for signing 7-day rotating refresh tokens
# Must be distinct from JWT_SECRET
# Type: string (min 32 chars)
JWT_REFRESH_SECRET=placeearly_refresh_secret_must_be_distinct_and_min_32_bytes!

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC VERIFICATION ENGINE (Ed25519)
# ------------------------------------------------------------------------------
# Institutional Ed25519 keypair for tamper-proof cryptographic academic seals.
# If omitted in development, ephemeral keys will be auto-generated in memory.
# In production, supply base64 or PEM encoded keys from your secure secret vault.
# Type: string (base64/hex) | Optional
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENCE LAYER (Anthropic Claude API)
# ------------------------------------------------------------------------------
# Anthropic Claude API Key for Resume Matcher, Mock Interviewer, and Prep Packs.
# Server-side isolated only; never exposed to browser client.
# If omitted or offline, deterministic rule-based fallback engine automatically activates.
# Type: string (sk-ant-api03-...) | Optional
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & ERROR MONITORING (Sentry)
# ------------------------------------------------------------------------------
# Sentry DSN for server-side error capturing, unhandled exceptions, and APM
# Type: string (URL) | Optional
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. DOCUMENT STORAGE PROVIDER
# ------------------------------------------------------------------------------
# Storage backend: 'local' (local disk / tmpdir) | 's3' (AWS S3 or Cloudflare R2)
# Type: string | Default: local
STORAGE_PROVIDER=local

# AWS S3 / Cloudflare R2 Configuration (Required only if STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=placeearly-institutional-vault
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 8. DATABASE BACKUPS & DISASTER RECOVERY
# ------------------------------------------------------------------------------
# Target local directory for automated JSON/BSON snapshot archives
# Type: string | Default: ./backups
BACKUP_DIR=./backups

# Number of days to retain backup archives before automatic pruning
# Type: number | Default: 14
BACKUP_RETENTION_DAYS=14
