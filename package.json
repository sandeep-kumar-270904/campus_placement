{
  "name": "placeearly",
  "version": "1.0.0",
  "private": true,
  "description": "PLACEearly - Campus Placement Operating System",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "status": "node scripts/run.js status",
    "quick": "node scripts/run.js help",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "seed:recruiter": "npm --prefix server run seed:recruiter",
    "seed:production": "npm --prefix server run seed:production",
    "db:backup": "npm --prefix server run db:backup",
    "db:restore": "npm --prefix server run db:restore",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage",
    "test:server": "npm --prefix server test",
    "test:all": "npm --prefix server test",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
